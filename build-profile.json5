{
  // M0 脚手架（2026-10-19 立项）：签名材料待各应用在 AGC 生成后，
  // 经 DevEco「项目结构 > 签名配置」绑定，或回填本文件 signingConfigs
  // （参照 PocketToolbox 1.4.x 实践：release/debug 双配置 + SHA256withECDSA）。
  "app": {
    "products": [
      {
        "name": "default",
        "signingConfig": "default",
        "targetSdkVersion": "6.0.0(20)",
        "compatibleSdkVersion": "6.0.0(20)",
        "runtimeOS": "HarmonyOS",
        "buildOption": {
          "strictMode": {
            "caseSensitiveCheck": true,
            "useNormalizedOHMUrl": true
          }
        }
      },
      {
        "name": "release",
        "signingConfig": "release",
        "targetSdkVersion": "6.0.0(20)",
        "compatibleSdkVersion": "6.0.0(20)",
        "runtimeOS": "HarmonyOS",
        "buildOption": {
          "strictMode": {
            "caseSensitiveCheck": true,
            "useNormalizedOHMUrl": true
          }
        }
      }
    ],
    "buildModeSet": [
      {
        "name": "debug"
      },
      {
        "name": "release"
      }
    ],
    "signingConfigs": [
      {
        "name": "default",
        "type": "HarmonyOS",
        "material": {
          "storeFile": "D:/keystore/debug.p12",
          "storePassword": "0000001827AF0B42F6EF14106D98712D7E14800CFD32E180A6F1B6D09D96281D0845413D84A4D502",
          "keyAlias": "debug",
          "keyPassword": "00000018C227BBFE5BAC20D55AF86A903A150DB79D76DB4811265BEA6C3379C6796500D27A8B2809",
          "signAlg": "SHA256withECDSA",
          "profile": "D:/keystore/markdown转换器调试Debug.p7b",
          "certpath": "D:/keystore/调试证书.cer"
        }
      },
      {
        "name": "release",
        "type": "HarmonyOS",
        "material": {
          "storeFile": "D:/keystore/toolbox.p12",
          "storePassword": "00000018210CB3F8DD51F5800A4240AA6ECC77D383EB3C87082F0E729BCE298C2E0F7FAA545EBA2A",
          "keyAlias": "toolbox",
          "keyPassword": "000000186B8712AF7DAACADBE213EC43B69E1CA85850C6B832D513C8793862A8BB7F311F79555009",
          "signAlg": "SHA256withECDSA",
          "profile": "D:/keystore/markdown转换器发布Release.p7b",
          "certpath": "D:/keystore/发布证书.cer"
        }
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default",
            "release"
          ]
        }
      ]
    }
  ]
}
